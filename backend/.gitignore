# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Virtual environment
venv/
.venv/
env/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# Type checking
.mypy_cache/

# ── Storage (never commit media files) ───────────────────────────────────────
storage/raw/*
storage/chunks/*
storage/outputs/*
storage/audio/*
!storage/raw/.gitkeep
!storage/chunks/video/.gitkeep
!storage/chunks/audio/.gitkeep
!storage/outputs/.gitkeep
!storage/audio/.gitkeep

# ── Model weights ─────────────────────────────────────────────────────────────
weights/
!weights/.gitkeep

# ── Celery ───────────────────────────────────────────────────────────────────
celerybeat-schedule
celerybeat-schedule.db

# ── Alembic compiled ─────────────────────────────────────────────────────────
alembic/versions/*.pyc
